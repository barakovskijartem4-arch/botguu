# Скопируйте в .env для локального запуска. Файл .env в git не попадает.
BOT_TOKEN=123456:ABC-ваш-токен-от-BotFather

# Необязательно: прокси для доступа к Telegram, например http://host:port или socks5://host:port
TELEGRAM_PROXY=

# Необязательно: путь к базе. По умолчанию /data/bot.db на сервере или bot.db локально.
DB_PATH=
